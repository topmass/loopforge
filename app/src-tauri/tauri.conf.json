{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoopForge",
  "version": "0.1.0",
  "identifier": "ai.northwave.loopforge",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "LoopForge",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": {
      "../../loopforge": "loopforge-launcher",
      "../../src": "loopforge-src"
    },
    "externalBin": []
  },
  "plugins": {}
}
